# Copy to .env and fill in your local provider key.
# .env is gitignored and loaded by the agent / scripts/import-dotenv.ps1.

POLZA_API_KEY=your_polza_api_key_here

# Optional: OpenAI-compatible provider (match api_key_env in agent-config)
# OPENAI_API_KEY=sk-...

# Optional: 1C workflow intake (mcp-atlassian). Names depend on your MCP setup.
# JIRA_URL=https://software.example.com
# JIRA_PERSONAL_TOKEN=
# CONFLUENCE_URL=https://confluence.example.com
# CONFLUENCE_PERSONAL_TOKEN=
