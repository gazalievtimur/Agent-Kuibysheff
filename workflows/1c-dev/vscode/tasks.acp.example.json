{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "1cIssueKey",
      "type": "promptString",
      "description": "Jira issue key (or leave empty when using TaskFile)",
      "default": "PROJ-123"
    },
    {
      "id": "1cStage",
      "type": "pickString",
      "description": "Workflow stage",
      "options": ["1", "2", "3", "4"],
      "default": "2"
    },
    {
      "id": "1cTaskFile",
      "type": "promptString",
      "description": "Optional task file path (skips intake; use with stage 2+)",
      "default": ""
    },
    {
      "id": "kuibysheffRoot",
      "type": "promptString",
      "description": "Absolute path to Agent Kuibysheff install (for prepare script)",
      "default": "C:/Git/Agent Kuibysheff"
    }
  ],
  "tasks": [
    {
      "label": "1c: prepare stage",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${input:kuibysheffRoot}/scripts/1c-dev-acp-prepare.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-RepoRoot",
        "${input:kuibysheffRoot}",
        "-IssueKey",
        "${input:1cIssueKey}",
        "-Stage",
        "${input:1cStage}",
        "-TaskFile",
        "${input:1cTaskFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "1c: approve plan",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${input:kuibysheffRoot}/scripts/1c-dev-acp-prepare.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-ApprovePlan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "1c: promote stage out",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${input:kuibysheffRoot}/scripts/1c-dev-acp-prepare.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-Stage",
        "${input:1cStage}",
        "-Promote"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "1c: validate stage",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${input:kuibysheffRoot}/scripts/1c-dev-acp-prepare.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-Stage",
        "${input:1cStage}",
        "-Validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "1c: promote and validate",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${input:kuibysheffRoot}/scripts/1c-dev-acp-prepare.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-Stage",
        "${input:1cStage}",
        "-Promote",
        "-Validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
