# Copy to <project>/.kuibyshev/product.yaml and adjust for this product.
# Paths are relative to the VS Code / --project-root folder unless absolute.

id: my-product
displayName: "My 1C product"
issueKeyRegex: '^[A-Z][A-Z0-9]+-\d+$'

# Task directories live under the opened project (or absolute path)
workspaceRoot: "."
# Product / CF dump root (usually the opened folder itself)
productRoot: "."
cfSrc: "src/cf"
cfeSrc: "src/cf/Extensions"
stagingReleaseBranch: ""
stagingDbPath: ""
taskDirPattern: "{workspaceRoot}/{issueKey}"
extensionNamePattern: "Ext_{number}"

mcp:
  # Hints for operators; actual MCP args live in agents/*/agent-config.yaml
  codeIndexPath: "{productRoot}/src/cf"
  sntxSemConfig: ""
  searxngUrl: "http://127.0.0.1:3000/mcp"
  codeIndexCommand: ""

apply:
  mode: extension_in_cf_dump
  buildScript: ""
