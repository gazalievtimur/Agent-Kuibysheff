# Copy to zup.yaml and adjust paths for your ZUP (or similar) workspace.
# Apply mode often differs: extension may live under CF dump Extensions/.

id: zup
displayName: "ZUP"
issueKeyRegex: '^[A-Z][A-Z0-9]+-\d+$'
workspaceRoot: "REQUIRED_WORKSPACE_ROOT"
productRoot: "REQUIRED_PRODUCT_ROOT"
cfSrc: "src/cf"
cfeSrc: "src/cf/Extensions"
stagingReleaseBranch: ""
stagingDbPath: "REQUIRED_STAGING_DB_PATH"
taskDirPattern: "{workspaceRoot}/{issueKey}"
extensionNamePattern: "{issueKey}"
mcp:
  codeIndexPath: "{productRoot}/src/cf"
  sntxSemConfig: "REQUIRED_SNTX_SEM_CONFIG"
  searxngUrl: "http://127.0.0.1:3000/mcp"
  codeIndexCommand: "REQUIRED_BSL_INDEXER"
apply:
  # Prefer copying out/cfe into productRoot/cfeSrc/<extensionName>/
  # instead of task _work/src + external BuildCfe script.
  mode: extension_in_cf_dump
  buildScript: ""

# Notes:
# - No staging CFE branch convention by default.
# - Prefer writing into an existing extension under src/cf/Extensions/...
# - Intake MCP (Atlassian) is the same; analyst/coder skills are shared.
# - Implementer packaging and apply-out must match your extension layout.
