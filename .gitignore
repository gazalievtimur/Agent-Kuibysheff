# Rust
/target/

# Runtime logs and demo output
/logs/
/demo-home/out/
/demo-home/searxng/out/
/run/out/

# Python bytecode
**/__pycache__/
*.py[cod]

# Local secrets and overrides
.env
.env.*
!.env.example
agent-config.local.yaml
# Provider-bound local AoC configs (keep *.aoc.example.yaml tracked)
**/agent-config.aoc.yaml

# IDE local MCP (keep mcp.json.example tracked)
.cursor/mcp.json

# Local Cursor plans (may contain machine paths / internal notes)
.cursor/plans/

# Local LLM regression reports (not committed)
/deepseek__*.json

# AoC eval data and run artifacts (not committed)
/local/aoc-bank/
/local/aoc-runs/
/local/aoc-sandbox-runtime/
/local/aoc-live-project/
/local/security-bank/
/local/security-runs/
/local/security-host-canary/
/workflows/aoc-live/project/

# 1C workflow run homes (not committed)
/workflows/1c-dev/runs/*
!/workflows/1c-dev/runs/.gitkeep

# Live AoC ACP workflow run homes (not committed)
/workflows/aoc-live/runs/*
!/workflows/aoc-live/runs/.gitkeep

# SWE-bench Verified workflow run artifacts (not committed)
/workflows/swebench-verified/runs/*
!/workflows/swebench-verified/runs/.gitkeep
/workflows/swebench-verified/artifacts/

# Scale-FS live regression (working banks / runs)
/local/scale-fs-bank/
/local/scale-fs-runs/
/local/scale-fs-sandbox-runtime/

# Scale-FS live workflow run homes (not committed)
/workflows/scale-fs-live/runs/*
!/workflows/scale-fs-live/runs/.gitkeep

# Local secret-scan reports (not committed)
/local/gitleaks-report.json

# Local product adapter paths (keep *.yaml.example in git)
/workflows/1c-dev/products/*.yaml
!/workflows/1c-dev/products/*.yaml.example

# Local code-index cache (not source)
src/.code-index/

# IDE / OS
.idea/
*.swp
Thumbs.db
Desktop.ini
